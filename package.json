{
  "name": "seu-renave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26.13 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "api:test:integration": "pnpm db:up && pnpm --filter @seu-renave/api test:integration",
    "check": "pnpm security:guards && pnpm typecheck && pnpm test && pnpm test:contract:serpro && pnpm test:smoke:serpro && pnpm build",
    "contract:serpro": "node scripts/check-serpro-contract.mjs && node scripts/check-serpro-first-slice.mjs && node scripts/check-serpro-guidance.mjs",
    "db:bootstrap": "pnpm --filter @seu-renave/db bootstrap",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @seu-renave/db migrate",
    "db:purge-identity": "pnpm --filter @seu-renave/db purge:identity",
    "db:scan-evidence": "pnpm --filter @seu-renave/db scan:evidence",
    "db:status-evidence": "pnpm --filter @seu-renave/db status:evidence",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:setup:local",
    "db:setup:local": "pnpm --filter @seu-renave/db setup:local",
    "db:test": "pnpm db:up && pnpm --filter @seu-renave/db test:integration",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "pnpm --filter @seu-renave/db --filter @seu-renave/identity build && pnpm --parallel --filter @seu-renave/api --filter @seu-renave/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reconciliation-worker:start": "pnpm --filter @seu-renave/reconciliation-worker-app start",
    "release:guard:reconciliation-worker": "node scripts/check-reconciliation-worker-release.mjs",
    "security:guards": "node scripts/check-security-guards.mjs --self-test && node scripts/check-security-guards.mjs && node --test scripts/check-reconciliation-worker-release.test.mjs && node scripts/check-reconciliation-worker-release.mjs",
    "smoke:serpro:fallback": "node scripts/smoke-serpro-fallback.mjs",
    "smoke:serpro:hml": "pnpm --filter @seu-renave/renave-connector build && node scripts/smoke-serpro-homologation.mjs",
    "stock-entry:bundle:generate": "pnpm --filter @seu-renave/stock-entry-provisioning cli generate-bundle",
    "stock-entry:profile-admin-key:generate": "pnpm --filter @seu-renave/stock-entry-provisioning cli generate-profile-admin-key",
    "stock-entry:pin:provision": "pnpm --filter @seu-renave/stock-entry-provisioning cli provision-pin",
    "stock-entry:pin:status": "pnpm --filter @seu-renave/stock-entry-provisioning cli pin-status",
    "stock-entry:profile:stage-operator": "pnpm --filter @seu-renave/stock-entry-provisioning cli stage-operator",
    "stock-entry:profile:stage-establishment": "pnpm --filter @seu-renave/stock-entry-provisioning cli stage-establishment",
    "stock-entry:profile:status": "pnpm --filter @seu-renave/stock-entry-provisioning cli profile-status",
    "stock-entry:profile:suspend-operator": "pnpm --filter @seu-renave/stock-entry-provisioning cli suspend-operator",
    "stock-entry:profile:suspend-establishment": "pnpm --filter @seu-renave/stock-entry-provisioning cli suspend-establishment",
    "test": "pnpm -r test",
    "test:integration": "pnpm db:up && pnpm --filter @seu-renave/db test:integration && pnpm --filter @seu-renave/api test:integration && pnpm --filter @seu-renave/stock-entry-provisioning test:integration",
    "test:contract:serpro": "node --test scripts/check-serpro-guidance.test.mjs",
    "test:foundation": "pnpm --filter @seu-renave/api test && pnpm --filter @seu-renave/web test",
    "test:smoke:serpro": "node --test scripts/smoke-serpro-homologation.test.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
