# Nunca coloque credenciais reais neste arquivo.
APP_ENVIRONMENT=homologation
PORT=3000
AUTH_MODE=disabled
# Em homologação/produção com OIDC, escolha explicitamente direct ou trusted-proxy.
# PROXY_MODE=direct
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,2001:db8::/32
# Para OIDC persistente: SESSION_STORE=postgres. Fora de desenvolvimento, DSN,
# CA, client secret e HMAC são lidos somente do mount fixo descrito abaixo.
# Máximo de consultas simultâneas ao store por réplica (1..6; padrão 4).
# SESSION_LOOKUP_MAX_CONCURRENCY=4
# MFA recente real: enviado ao IdP como max_age e validado contra auth_time.
# OIDC_MAX_AUTHENTICATION_AGE_SECONDS=300

# Banco de negócio e banco de sessão usam papéis distintos. Nunca reutilize
# senhas entre eles. Em homologação/produção, variáveis de ambiente com DSN,
# CA ou HMAC são recusadas.
# Para o job agendado de evidências; papel sem leitura direta de tabelas.
# MAINTENANCE_DATABASE_URL=postgres://renave_maintenance_app:CHANGE_ME@127.0.0.1:54317/renave
# Para o worker de operações; sem acesso direto a tabelas.
# OPERATION_WORKER_DATABASE_URL=postgres://renave_operation_worker:CHANGE_ME@127.0.0.1:54317/renave
# Tamanho de cada lote (1..1000; padrão 100).
# EVIDENCE_MONITOR_BATCH_SIZE=100
# Alerta se não houver execução bem-sucedida neste intervalo (1..86400;
# use ao menos o dobro da frequência do scheduler; padrão 900).
# EVIDENCE_MONITOR_MAX_SILENCE_SECONDS=900

# A integração executável continua desabilitada até existirem certificado e
# vínculo de integradora válidos em homologação.
RENAVE_INTEGRATION_ENABLED=false
# RENAVE_INTEGRATOR_CNPJ=00000000000000
# A API lê DSNs, CAs, HMACs, client secret OIDC, material mTLS e keyring de
# evidência somente de /run/secrets/seu-renave/api/. Consulte o runbook.

# Retenção local da entrada de estoque. As duas flags permanecem desligadas
# até bundle, backup restaurado, pin write-once, perfis e vínculo estarem prontos.
RENAVE_STOCK_ENTRY_LOCAL_ENABLED=false
# VITE_RENAVE_STOCK_ENTRY_LOCAL_ENABLED=false
# A API lê o bundle somente do mount fixo:
# /run/secrets/seu-renave/api-stock-entry/keys.json
# O provisionador lê bundle/CA somente de:
# /run/secrets/seu-renave/stock-entry-provisioning/
# DATABASE_MIGRATOR_URL=postgres://renave_migrator:CHANGE_ME@127.0.0.1:54317/renave
# Administração de perfis usa exclusivamente renave_profile_provisioner e TLS
# validado pela CA fixa database-ca.pem do mount. PII nunca entra no ambiente.
# DATABASE_PROFILE_PROVISIONER_URL=postgres://renave_profile_provisioner:CHANGE_ME@db.example/renave
# Consulta sanitizada usa outra credencial, global e estritamente read-only.
# DATABASE_PROFILE_READER_URL=postgres://renave_profile_reader:CHANGE_ME@db.example/renave
# Console global: provisionamento offline e leitura usam credenciais distintas;
# nenhum dos papéis possui acesso direto às tabelas.
# DATABASE_PLATFORM_PROVISIONER_URL=postgres://renave_platform_provisioner:CHANGE_ME@db.example/renave
# DATABASE_PLATFORM_READER_URL=postgres://renave_platform_reader:CHANGE_ME@db.example/renave
# Capability da API global (desligada por padrão). Quando ativa, DSN do reader,
# CA e chave HMAC vêm somente do mount fixo da API.
PLATFORM_CONSOLE_ENABLED=false
# Capability pública de apresentação, incorporada no build Vite. Ela não libera
# dados sem o gate da API e também permanece desligada por padrão.
VITE_PLATFORM_CONSOLE_ENABLED=false
# PLATFORM_OPERATOR_MFA_MAX_AGE_SECONDS=300
# Confirmação não secreta exigida apenas no comando write-once:
# STOCK_ENTRY_PIN_WRITE_ONCE_ACK=BACKUP_AND_RESTORE_VERIFIED_WRITE_ONCE

# Worker de reconciliação: dupla ativação. Desabilitado por padrão; quando
# habilitado, permanece em dry-run até a troca explícita para false.
RENAVE_RECONCILIATION_WORKER_ENABLED=false
# RENAVE_RECONCILIATION_WORKER_DRY_RUN=true
# Use exclusivamente o papel renave_operation_worker.
# Segredos do worker são lidos apenas de arquivos sob o diretório fixo
# /run/secrets/seu-renave/reconciliation-worker. Consulte o README do app para
# os nomes obrigatórios. Variáveis de ambiente com segredos são recusadas.
# RENAVE_RECONCILIATION_TENANT_ALLOWLIST=00000000-0000-4000-8000-000000000000
# RENAVE_RECONCILIATION_LEASE_OWNER=00000000-0000-4000-8000-000000000001
# RENAVE_RECONCILIATION_ACTIVE_PROJECTION_KEY_ID=key-YYYY-MM
# RENAVE_RECONCILIATION_HEARTBEAT_MS=30000
# RENAVE_RECONCILIATION_POLL_MS=5000
# RENAVE_RECONCILIATION_HEALTH_PORT=9464
