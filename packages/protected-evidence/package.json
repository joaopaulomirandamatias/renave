{
  "name": "@seu-renave/protected-evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./stock-entry-key-bundle": {
      "types": "./src/stock-entry-key-bundle.ts",
      "production": "./dist/stock-entry-key-bundle.js",
      "default": "./src/stock-entry-key-bundle.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seu-renave/db": "workspace:*",
    "@seu-renave/renave-connector": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
