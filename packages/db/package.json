{
  "name": "@seu-renave/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./operation-worker": {
      "types": "./src/operation-worker.ts",
      "production": "./dist/operation-worker.js",
      "default": "./src/operation-worker.ts"
    },
    "./api-runtime": {
      "types": "./src/api-runtime.ts",
      "production": "./dist/api-runtime.js",
      "default": "./src/api-runtime.ts"
    },
    "./tenant-runtime": {
      "types": "./src/tenant-runtime.ts",
      "production": "./dist/tenant-runtime.js",
      "default": "./src/tenant-runtime.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "migrate": "tsx src/cli.ts migrate",
    "purge:identity": "tsx src/cli.ts purge-identity",
    "scan:evidence": "tsx src/cli.ts scan-evidence",
    "status:evidence": "tsx src/cli.ts status-evidence",
    "setup:local": "tsx src/cli.ts setup-local",
    "test": "vitest run --project unit",
    "test:integration": "NODE_OPTIONS=--throw-deprecation vitest run --project integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seu-renave/access-control": "workspace:*",
    "@seu-renave/identity": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
